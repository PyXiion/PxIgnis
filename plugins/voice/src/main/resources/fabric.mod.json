{
  "schemaVersion": 1,
  "id": "ignis-voice",
  "version": "${version}",
  "name": "PxIgnis Voice",
  "description": "PxIgnis plugin: play .ogg and .wav files to players through Simple Voice Chat (require(\"ext:voice\")).",
  "authors": [
    {
      "name": "PyXiion",
      "contact": {
        "homepage": "https://pyxiion.ru"
      }
    }
  ],
  "contact": {
    "homepage": "https://ignis.pyxiion.ru",
    "sources": "https://github.com/PyXiion/PxIgnis",
    "issues": "https://github.com/PyXiion/PxIgnis/issues"
  },
  "license": "LGPL-3.0",
  "environment": "server",
  "entrypoints": {
    "pxignis": [
      {
        "adapter": "kotlin",
        "value": "ru.pyxiion.ignis.voice.VoicePlugin"
      }
    ],
    "voicechat": [
      {
        "adapter": "kotlin",
        "value": "ru.pyxiion.ignis.voice.svc.SvcPlugin"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-language-kotlin": ">=1.13.8+kotlin.2.3.0",
    "pxignis": "~${version}"
  },
  "suggests": {
    "voicechat": "*"
  }
}
