{
  "schemaVersion": 1,
  "id": "ignis-mapcanvas",
  "version": "${version}",
  "name": "PxIgnis MapCanvas",
  "description": "PxIgnis plugin: virtual map canvases, map walls (require(\"ext:mapcanvas\")).",
  "authors": [
    {
      "name": "PyXiion",
      "contact": {
        "homepage": "https://pyxiion.ru"
      }
    }
  ],
  "contact": {
    "homepage": "https://ignis.pyxiion.ru",
    "sources": "https://github.com/PyXiion/PxIgnis",
    "issues": "https://github.com/PyXiion/PxIgnis/issues"
  },
  "license": "LGPL-3.0",
  "environment": "server",
  "entrypoints": {
    "pxignis": [
      {
        "adapter": "kotlin",
        "value": "ru.pyxiion.ignis.mapcanvas.MapCanvasPlugin"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-language-kotlin": ">=1.13.8+kotlin.2.3.0",
    "pxignis": "~${version}"
  }
}
